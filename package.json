{
  "name": "claude-agent-api",
  "version": "0.1.0",
  "description": "Expose your local Claude Code (via the Claude Agent SDK) as an OpenAI- and Anthropic-compatible HTTP API, in the style of copilot-api.",
  "type": "module",
  "bin": {
    "claude-agent-api": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --watch src/main.ts start --verbose",
    "start": "node dist/main.js start",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/*.test.ts\""
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agent-sdk",
    "openai-compatible",
    "proxy"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.331",
    "@anthropic-ai/sdk": "^1.13.0",
    "@hono/node-server": "^2.1.11",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "hono": "^4.13.21"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
